msgstr "الاتصال بـ XPay في الوضع الفعلي"

#: includes/admin/class-xpay-admin-screen.php:603
msgid "Connect with XPay in test mode"
msgstr "الاتصال بـ XPay في الوضع التجريبي"

#: includes/admin/class-xpay-admin-screen.php:604
