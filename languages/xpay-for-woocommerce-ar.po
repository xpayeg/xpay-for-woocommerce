msgstr "مفتاح pk_test_…، تستخدمه نافذة الدفع الآمنة في المتصفح."

#: includes/gateway/class-xpay-gateway.php:139
msgid "Test webhook signing secret"
msgstr "سر توقيع webhook للاختبار"

