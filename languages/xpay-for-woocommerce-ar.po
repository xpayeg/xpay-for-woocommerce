#, php-format
msgid "XPay: the API key did not validate — %s"
msgstr "XPay: تعذّر التحقق من مفتاح API — %s"

#: includes/gateway/class-xpay-gateway.php:363
msgid "The payment could not be started. Please try again — your card has not been charged."
msgstr "تعذّر بدء عملية الدفع. من فضلك حاول مرة أخرى — لم يتم الخصم من بطاقتك."

#. translators: 1: XPay error code, 2: error message.
