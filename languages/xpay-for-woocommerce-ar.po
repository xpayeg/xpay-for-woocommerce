#: includes/gateway/class-xpay-gateway.php:116
msgid "Live"
msgstr "مباشر"

#: includes/gateway/class-xpay-gateway.php:120
msgid "Test secret key"
msgstr "المفتاح السري للاختبار"

#: includes/gateway/class-xpay-gateway.php:122
msgid "A restricted key (rk_test_…) with Checkout Sessions and Refunds access, from your XPay dashboard → Developers → API keys."
msgstr "مفتاح مقيّد (rk_test_…) بصلاحية جلسات الدفع والمبالغ المستردة، من لوحة تحكم XPay ← Developers ← API keys."

#: includes/gateway/class-xpay-gateway.php:125
