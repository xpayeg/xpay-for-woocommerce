msgstr "فشل إنشاء جلسة XPay ‏[%1$s]: %2$s"

#: includes/gateway/class-xpay-gateway.php:404
msgid "The payment could not be started. Please refresh the page to try again."
msgstr "تعذّر بدء عملية الدفع. من فضلك حدّث الصفحة وحاول مرة أخرى."

#: includes/gateway/class-xpay-gateway.php:435
#: includes/gateway/class-xpay-pay-page.php:63
msgid "Opening secure payment…"
msgstr "جارٍ فتح الدفع الآمن…"

#: includes/gateway/class-xpay-gateway.php:436
msgid "Taking you to the secure payment page…"
msgstr "جارٍ نقلك إلى صفحة الدفع الآمنة…"

