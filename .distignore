# Files and directories EXCLUDED from the WP.org distribution ZIP.
# Any pattern here is interpreted as an rsync --exclude rule (also
# compatible with `wp dist-archive` from wp-cli/dist-archive-command).
#
# Anything NOT matched here is included in the ZIP.

# --- Version control ---
.git/
.gitignore
.gitattributes
.github/
.svn/
.distignore

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
._*
Thumbs.db

# --- Build / dependency manifests ---
node_modules/
vendor/
composer.json
composer.lock
package.json
package-lock.json
yarn.lock
Makefile

# --- Build outputs ---
dist/
build/
bin/

# --- Tests ---
tests/
tests-contracts/
phpunit.xml
phpunit-contracts.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
.phpunit.result.cache

# --- Repo-only documentation (WP.org uses readme.txt + the bundled
#     `== Changelog ==` section instead). The merchant guides under docs/
#     SHIP: the settings screen's doc viewer opens them in wp-admin.
#     Only the two maintainer docs stay repo-only. ---
README.md
CHANGELOG.md
docs/PACKAGING.md
docs/WORDPRESS_ORG_SUBMISSION.md

# --- Repo-only screenshots folder. WP.org screenshots live in the
#     SVN /assets/ directory (uploaded separately, not in the plugin ZIP). ---
screenshots/

# --- WP.org plugin-page assets (banner, icon, screenshots). These ship
#     to wordpress.org via SVN /assets/, NOT in the plugin ZIP. ---
wporg-assets/

# --- Logs / temp ---
*.log
*.tmp
*.bak

# --- Development tooling (v3): never ships in the WP.org ZIP ---
AGENTS.md
HANDOFF.md
HANDOFF-ELEMENTS.md
tools/
composer.json
composer.lock
vendor/
phpcs.xml
phpunit.xml.dist
tests/
.github/
.phpcs.xml.dist
.coderabbit.yaml
